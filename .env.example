FOLIO_SECRET_KEY=change-me-to-a-long-random-string
FOLIO_ADMIN_KEY=change-me-admin-key
FOLIO_ADMIN_EMAIL=1797098277@qq.com
FOLIO_ADMIN_USERNAME=fan
FOLIO_ADMIN_PASSWORD=
# 线上用 Neon / Supabase 免费 Postgres；不设则本机仍用 SQLite。
DATABASE_URL=
FOLIO_DB=data/folio.db
FOLIO_DATA_DIR=data
FOLIO_CATALOG_DIR=data
PORT=8000
HOST=0.0.0.0

# 封面 / 头像 CDN（可选）。设置后封面从该域名加载；头像上传也会写到同一 bucket。
# FOLIO_COVER_BASE_URL=https://pub-xxxxx.r2.dev
# 本地封面离线目录（JPG/WebP/AVIF 不在 git 内）：
# FOLIO_COVERS_DIR=/path/to/folio-covers-offline/covers
#
# 上传到 R2/S3（封面脚本 + 线上头像上传都需要）：
# FOLIO_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# FOLIO_S3_ACCESS_KEY=
# FOLIO_S3_SECRET_KEY=
# FOLIO_S3_BUCKET=foliocovers
# FOLIO_S3_PUBLIC_BASE=https://pub-xxxxx.r2.dev
# FOLIO_S3_PREFIX=covers
#
# Render 上也要配上述 FOLIO_S3_*（头像 + 荐书封面上传写 R2）。
# 迁移已有本机上传：python3 scripts/upload_user_uploads_s3.py
